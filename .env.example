DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:56322/postgres"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:56321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-supabase-anon-key"

# Backend-only Admin API key; used by the seed and user creation, never by browser code.
SUPABASE_SECRET_KEY="replace-with-your-supabase-secret-key"
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"
# Display name saved in Supabase metadata and the Prisma profile; defaults to Super Admin.
SEED_SUPER_ADMIN_FULL_NAME=""
