{
  "name": "b1g-fuel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev:web\" \"npm run dev:api\"",
    "build": "prisma generate && next build",
    "start": "concurrently -k -n web,api \"npm run start:web\" \"npm run start:api\"",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test:access": "node --import tsx --test tests/role-access.test.tsx tests/role-company-db.test.ts tests/record-access.test.ts tests/record-access-db.test.ts tests/created-by.test.ts",
    "db:generate": "prisma migrate dev --create-only",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "dev:web": "next dev",
    "dev:api": "tsx watch src/server/index.ts",
    "start:web": "next start",
    "start:api": "tsx src/server/index.ts",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:client": "prisma generate",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@reduxjs/toolkit": "^2.13.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "swagger-ui-dist": "^5.33.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "prisma": {
      "mysql2": "^3.24.5"
    }
  }
}
