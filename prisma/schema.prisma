generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  // Same UUID as the Supabase Auth account.
  id             String         @id @db.Uuid
  email          String?        @unique
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @updatedAt @db.Timestamptz(6)
  user_roles     user_role[]
  user_companies user_company[]
}

enum role_scope {
  global
  company
}

// Global assignments such as super_admin; migration CHECK enforces global scope.
model user_role {
  user_id     String     @db.Uuid
  role_id     String     @db.Uuid
  scope       role_scope @default(global)
  assigned_at DateTime   @default(now()) @db.Timestamptz(6)
  user        user       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role        roles      @relation("global_assignments", fields: [role_id, scope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict)

  @@id([user_id, role_id])
  @@index([role_id, scope])
}

model company {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(160)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @updatedAt @db.Timestamptz(6)
  user_companies user_company[]
}

model user_company {
  id          String              @id @default(uuid()) @db.Uuid
  user_id     String              @db.Uuid
  company_id  String              @db.Uuid
  assigned_at DateTime            @default(now()) @db.Timestamptz(6)
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at  DateTime            @updatedAt @db.Timestamptz(6)
  user        user                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company     company             @relation(fields: [company_id], references: [id], onDelete: Cascade)
  roles       user_company_role[]

  @@unique([user_id, company_id])
  @@index([company_id])
}

model roles {
  id              String              @id @default(uuid()) @db.Uuid
  name            String              @db.VarChar(100)
  slug            String              @unique @db.VarChar(100)
  scope           role_scope          @default(company)
  is_system       Boolean             @default(false)
  is_default_role Boolean             @default(false)
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  updated_at      DateTime            @updatedAt @db.Timestamptz(6)
  pages           role_pages[]
  permissions     role_permissions[]
  user_roles      user_role[]         @relation("global_assignments")
  company_roles   user_company_role[] @relation("company_assignments")

  @@unique([id, scope])
}

// Roles are assigned to memberships; migration CHECK enforces company scope.
model user_company_role {
  user_company_id String       @db.Uuid
  role_id         String       @db.Uuid
  scope           role_scope   @default(company)
  assigned_at     DateTime     @default(now()) @db.Timestamptz(6)
  membership      user_company @relation(fields: [user_company_id], references: [id], onDelete: Cascade)
  role            roles        @relation("company_assignments", fields: [role_id, scope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict)

  @@id([user_company_id, role_id])
  @@index([role_id, scope])
}

model role_pages {
  role_id  String @db.Uuid
  page_key String @db.VarChar(120)
  role     roles  @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, page_key])
}

model role_permissions {
  role_id        String @db.Uuid
  permission_key String @db.VarChar(120)
  role           roles  @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_key])
}
