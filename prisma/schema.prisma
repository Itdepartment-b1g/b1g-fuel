generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  // Same UUID as the Supabase Auth account.
  id             String         @id @db.Uuid
  name           String         @db.VarChar(250)
  created_by     String?        @db.Uuid
  email          String?        @unique
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @updatedAt @db.Timestamptz(6)
  user_roles     user_role[]
  user_companies user_company[]
  @@index([created_by])
}

enum role_scope {
  global
  company
}

enum page_grant_mode {
  role_pages
  assigned_pages
}

enum facility_type {
  warehouse
  hub
}

// Global assignments such as super_admin; migration CHECK enforces global scope.
model user_role {
  user_id     String     @db.Uuid
  role_id     String     @db.Uuid
  scope       role_scope @default(global)
  assigned_at DateTime   @default(now()) @db.Timestamptz(6)
  user        user       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role        roles      @relation("global_assignments", fields: [role_id, scope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict)

  @@id([user_id, role_id])
  @@index([role_id, scope])
}

model company {
  id             String         @id @default(uuid()) @db.Uuid
  code           String?        @unique @db.VarChar(16)
  name           String         @db.VarChar(160)
  created_by     String?        @db.Uuid
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @updatedAt @db.Timestamptz(6)
  user_companies user_company[]
  roles          roles[]
  measurements   measurement[]
  brands         brand[]
  variants       variant[]
  suppliers      supplier[]
  facilities      facility[]
  product_types   product_type[]
  products        product[]
  purchase_orders purchase_order[]
  receivings      receiving[]
  material_requests_sent material_request[] @relation("mr_requester")
  material_requests_received material_request[] @relation("mr_supplier")
  material_request_counters material_request_counter[]
  material_request_receivings material_request_receiving[]
  material_request_dispatches material_request_dispatch[]
  supply_relationships_as_requester company_supply_relationship[] @relation("requesting_company_supply")
  supply_relationships_as_supplier  company_supply_relationship[] @relation("supplying_company_supply")
  @@index([created_by])
}

// Directed supply authorization. Facility ownership and company memberships stay independent.
model company_supply_relationship {
  id                    String   @id @default(uuid()) @db.Uuid
  requesting_company_id String   @db.Uuid
  supplying_company_id  String   @db.Uuid
  is_active             Boolean  @default(true)
  created_by            String   @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)
  requesting_company    company  @relation("requesting_company_supply", fields: [requesting_company_id], references: [id], onDelete: Restrict, map: "company_supply_requester_fkey")
  supplying_company     company  @relation("supplying_company_supply", fields: [supplying_company_id], references: [id], onDelete: Restrict, map: "company_supply_supplier_fkey")
  material_requests material_request[]

  @@unique([requesting_company_id, supplying_company_id], map: "company_supply_requester_supplier_key")
  @@index([supplying_company_id, is_active], map: "company_supply_supplier_active_idx")
  @@index([created_by], map: "company_supply_created_by_idx")
}

model measurement {
  id         String   @id @default(uuid()) @db.Uuid
  company_id String?  @db.Uuid
  created_by String?  @db.Uuid
  name       String   @db.VarChar(160)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  company    company? @relation(fields: [company_id], references: [id], onDelete: Restrict)
  units      measurement_unit[]

  @@unique([company_id, name])
  @@index([created_by])
}

model measurement_unit {
  id             String      @id @default(uuid()) @db.Uuid
  measurement_id String      @db.Uuid
  key            String      @db.VarChar(64)
  name           String      @db.VarChar(100)
  symbol         String      @db.VarChar(20)
  measurement            measurement            @relation(fields: [measurement_id], references: [id], onDelete: Restrict)
  products               product[]
  purchase_order_items   purchase_order_item[]
  receiving_items        receiving_item[]
  material_request_items material_request_item[]
  material_request_receiving_items material_request_receiving_item[]
  material_request_dispatch_items material_request_dispatch_item[]

  @@unique([measurement_id, key])
  @@unique([measurement_id, symbol])
}

model user_company {
  id               String              @id @default(uuid()) @db.Uuid
  user_id          String              @db.Uuid
  company_id       String              @db.Uuid
  page_grant_mode  page_grant_mode     @default(role_pages)
  assigned_at      DateTime            @default(now()) @db.Timestamptz(6)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @updatedAt @db.Timestamptz(6)
  user             user                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company          company             @relation(fields: [company_id], references: [id], onDelete: Cascade)
  roles            user_company_role[]
  pages            user_company_page[]
  permissions      user_company_permission[]
  facilities        user_facility[]

  @@unique([user_id, company_id])
  @@unique([id, company_id])
  @@index([company_id])
}

// Checked dashboards for one membership. Used only when page_grant_mode is assigned_pages.
model user_company_page {
  user_company_id String       @db.Uuid
  page_key        String       @db.VarChar(120)
  membership      user_company @relation(fields: [user_company_id], references: [id], onDelete: Cascade)

  @@id([user_company_id, page_key])
}

// Actions chosen for one staff membership. Used when page_grant_mode is assigned_pages.
model user_company_permission {
  user_company_id String       @db.Uuid
  permission_key  String       @db.VarChar(120)
  access_scope    String       @default("company") @db.VarChar(16)
  membership      user_company @relation(fields: [user_company_id], references: [id], onDelete: Cascade)

  @@id([user_company_id, permission_key])
}

model roles {
  id              String              @id @default(uuid()) @db.Uuid
  name            String              @db.VarChar(100)
  slug            String              @unique @db.VarChar(100)
  scope           role_scope          @default(company)
  company_id      String?             @db.Uuid
  created_by      String?             @db.Uuid
  company         company?            @relation(fields: [company_id], references: [id], onDelete: Restrict)
  is_system       Boolean             @default(false)
  is_default_role Boolean             @default(false)
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  updated_at      DateTime            @updatedAt @db.Timestamptz(6)
  pages           role_pages[]
  permissions     role_permissions[]
  user_roles      user_role[]         @relation("global_assignments")
  company_roles   user_company_role[] @relation("company_assignments")

  @@unique([id, scope])
  @@index([company_id])
  @@index([created_by])
}

// Roles are assigned to memberships; migration CHECK enforces company scope.
model user_company_role {
  user_company_id String       @db.Uuid
  role_id         String       @db.Uuid
  scope           role_scope   @default(company)
  assigned_at     DateTime     @default(now()) @db.Timestamptz(6)
  membership      user_company @relation(fields: [user_company_id], references: [id], onDelete: Cascade)
  role            roles        @relation("company_assignments", fields: [role_id, scope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict)

  @@id([user_company_id, role_id])
  @@index([role_id, scope])
}

model role_pages {
  role_id  String @db.Uuid
  page_key String @db.VarChar(120)
  role     roles  @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, page_key])
}

model role_permissions {
  role_id        String @db.Uuid
  permission_key String @db.VarChar(120)
  access_scope   String @default("company") @db.VarChar(16)
  role           roles  @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_key])
}

model brand {
  id          String    @id @default(uuid()) @db.Uuid
  company_id  String?   @db.Uuid
  supplier_id String?   @db.Uuid
  created_by  String?   @db.Uuid
  name        String    @db.VarChar(160)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  company     company?  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  supplier    supplier? @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  variants    variant[]

  @@unique([company_id, name])
  @@index([created_by])
  @@index([company_id])
  @@index([supplier_id])
}

model variant {
  id         String   @id @default(uuid()) @db.Uuid
  brand_id   String   @db.Uuid
  company_id String?  @db.Uuid
  created_by String?  @db.Uuid
  name       String   @db.VarChar(160)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  brand      brand     @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  company    company?  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  products   product[]

  @@unique([brand_id, company_id, name])
  @@index([created_by])
  @@index([brand_id])
  @@index([company_id])
}

model supplier {
  id String @id @default(uuid()) @db.Uuid
  company_id String? @db.Uuid
  created_by String? @db.Uuid

  name String @db.VarChar(160)
  contact_person String @db.VarChar(160)
  contact_email String @db.VarChar(160)
  contact_phone String @db.VarChar(160)
  contact_address String @db.VarChar(160)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  company         company?         @relation(fields: [company_id], references: [id], onDelete: Restrict)
  brands          brand[]
  purchase_orders purchase_order[]

  @@index([created_by])
  @@index([company_id])
  @@unique([company_id, name])
}

model facility {
  id         String        @id @default(uuid()) @db.Uuid
  company_id String        @db.Uuid
  created_by String?       @db.Uuid
  name       String        @db.VarChar(160)
  type       facility_type
  address    String        @default("") @db.VarChar(160)
  is_active  Boolean       @default(true)
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @updatedAt @db.Timestamptz(6)
  company         company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  material_requests_from material_request[] @relation("mr_hub")
  material_requests_to material_request[] @relation("mr_warehouse")
  material_request_receivings material_request_receiving[]
  material_request_dispatches material_request_dispatch[]
  inventories inventory[]
  stock_movements stock_movement[]
  purchase_orders purchase_order[]
  receivings      receiving[]
  users           user_facility[]
  assignment_history user_facility_history[]

  @@unique([company_id, name])
  @@unique([id, company_id])
  @@index([created_by])
  @@index([company_id])
  @@index([type])
}

// Company is repeated to enforce same-company assignments with composite foreign keys.
model user_facility {
  id              String       @id @default(uuid()) @db.Uuid
  company_id      String       @db.Uuid
  user_company_id String       @db.Uuid
  facility_id     String       @db.Uuid
  assigned_by     String       @db.Uuid
  assigned_at     DateTime     @default(now()) @db.Timestamptz(6)
  membership      user_company @relation(fields: [user_company_id, company_id], references: [id, company_id], onDelete: Cascade, onUpdate: Restrict)
  facility        facility     @relation(fields: [facility_id, company_id], references: [id, company_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([user_company_id, facility_id])
  @@index([facility_id, company_id])
  @@index([user_company_id, company_id])
  @@index([assigned_by])
}

// Snapshot each assignment period independently of current company membership.
model user_facility_history {
  id               String   @id @db.Uuid
  company_id       String   @db.Uuid
  facility_id      String   @db.Uuid
  user_company_id  String   @db.Uuid
  user_id          String   @db.Uuid
  name             String   @db.VarChar(250)
  email            String?
  user_created_at  DateTime @db.Timestamptz(6)
  assigned_by      String   @db.Uuid
  assigned_by_name String?  @db.VarChar(250)
  assigned_at      DateTime @db.Timestamptz(6)
  unassigned_at    DateTime? @db.Timestamptz(6)
  facility         facility @relation(fields: [facility_id, company_id], references: [id, company_id], onDelete: Restrict, onUpdate: Restrict)

  @@index([facility_id, company_id])
  @@index([facility_id, user_created_at, assigned_at], map: "user_facility_history_facility_id_user_created_at_assigned_at_i")
}

model product_type {
  id         String    @id @default(uuid()) @db.Uuid
  company_id String?   @db.Uuid
  created_by String?   @db.Uuid
  name       String    @db.VarChar(160)
  key        String    @db.VarChar(64)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  company    company?  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  products   product[]

  @@unique([company_id, key])
  @@unique([company_id, name])
  @@index([created_by])
  @@index([company_id])
}

model product {
  id              String           @id @default(uuid()) @db.Uuid
  company_id      String           @db.Uuid
  variant_id      String           @db.Uuid
  base_unit_id    String           @db.Uuid
  product_type_id String           @db.Uuid
  created_by      String?          @db.Uuid
  note            String           @default("") @db.VarChar(160)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @updatedAt @db.Timestamptz(6)
  company         company          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  variant         variant          @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  base_unit       measurement_unit @relation(fields: [base_unit_id], references: [id], onDelete: Restrict)
  product_type         product_type         @relation(fields: [product_type_id], references: [id], onDelete: Restrict)
  purchase_order_items purchase_order_item[]
  receiving_items      receiving_item[]
  material_request_items material_request_item[]
  material_request_receiving_items material_request_receiving_item[]
  material_request_dispatch_items material_request_dispatch_item[]
  inventories inventory[]
  stock_movements stock_movement[]

  @@unique([company_id, variant_id, product_type_id])
  @@index([created_by])
  @@index([company_id])
  @@index([variant_id])
  @@index([base_unit_id])
  @@index([product_type_id])
}

enum material_request_status {
  draft
  submitted
  approved
  partially_dispatched
  fully_dispatched
  partially_received
  received
  closed
  rejected
  cancelled
}

enum material_request_event_kind {
  created
  updated
  submitted
  approved
  rejected
  cancelled
  receipt_posted
  dispatched
  closed
}

enum material_request_receiving_status {
  draft
  posted
}

model material_request {
  id String @id @default(uuid()) @db.Uuid
  request_no String? @db.VarChar(64)
  supply_relationship_id String @db.Uuid
  requesting_company_id String @db.Uuid
  supplying_company_id String @db.Uuid
  requesting_hub_id String @db.Uuid
  supplying_warehouse_id String? @db.Uuid
  status material_request_status @default(draft)
  notes String @default("") @db.VarChar(1000)
  needed_at DateTime? @db.Timestamptz(6)
  created_by String @db.Uuid
  submitted_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  supply_relationship company_supply_relationship @relation(fields: [supply_relationship_id], references: [id], onDelete: Restrict)
  requesting_company company @relation("mr_requester", fields: [requesting_company_id], references: [id], onDelete: Restrict)
  supplying_company company @relation("mr_supplier", fields: [supplying_company_id], references: [id], onDelete: Restrict)
  requesting_hub facility @relation("mr_hub", fields: [requesting_hub_id], references: [id], onDelete: Restrict)
  supplying_warehouse facility? @relation("mr_warehouse", fields: [supplying_warehouse_id], references: [id], onDelete: Restrict)
  items material_request_item[]
  events material_request_event[]
  receivings material_request_receiving[]
  dispatches material_request_dispatch[]
  @@unique([requesting_company_id, request_no])
  @@unique([id, requesting_hub_id, requesting_company_id], map: "material_request_hub_company_key")
  @@index([requesting_company_id, created_at])
  @@index([supplying_company_id, status, created_at])
  @@index([requesting_hub_id])
  @@index([supplying_warehouse_id])
  @@index([supply_relationship_id])
  @@index([created_by])
}

model material_request_item {
  id String @id @default(uuid()) @db.Uuid
  material_request_id String @db.Uuid
  product_id String @db.Uuid
  unit_id String @db.Uuid
  requested_qty Decimal @db.Decimal(14, 3)
  approved_qty Decimal? @db.Decimal(14, 3)
  dispatched_qty Decimal @default(0) @db.Decimal(14, 3)
  received_qty Decimal @default(0) @db.Decimal(14, 3)
  product_label String @db.VarChar(600)
  unit_label String @db.VarChar(120)
  request material_request @relation(fields: [material_request_id], references: [id], onDelete: Restrict)
  receivings material_request_receiving_item[]
  dispatches material_request_dispatch_item[]
  product product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  unit measurement_unit @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  @@unique([material_request_id, product_id])
  @@index([product_id])
  @@index([unit_id])
}

model material_request_event {
  id String @id @default(uuid()) @db.Uuid
  material_request_id String @db.Uuid
  kind material_request_event_kind
  from_status material_request_status?
  to_status material_request_status
  note String @default("") @db.VarChar(1000)
  created_by String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  material_request_receiving_id String? @db.Uuid
  request material_request @relation(fields: [material_request_id], references: [id], onDelete: Restrict)
  receiving material_request_receiving? @relation(fields: [material_request_receiving_id], references: [id], onDelete: Restrict, map: "material_request_event_receiving_fkey")
  @@index([material_request_id, created_at])
  @@index([material_request_receiving_id])
  @@index([created_by])
}

model material_request_receiving {
  id String @id @default(uuid()) @db.Uuid
  requesting_company_id String @db.Uuid
  material_request_id String @db.Uuid
  facility_id String @db.Uuid
  status material_request_receiving_status @default(draft)
  receipt_seq Int?
  receiving_no String? @db.VarChar(64)
  notes String @default("") @db.VarChar(1000)
  created_by String @db.Uuid
  posted_by String? @db.Uuid
  posted_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  company company @relation(fields: [requesting_company_id], references: [id], onDelete: Restrict)
  request material_request @relation(fields: [material_request_id, facility_id, requesting_company_id], references: [id, requesting_hub_id, requesting_company_id], onDelete: Restrict, map: "material_request_receiving_request_fkey")
  facility facility @relation(fields: [facility_id], references: [id], onDelete: Restrict)
  items material_request_receiving_item[]
  events material_request_event[]

  @@unique([requesting_company_id, receipt_seq])
  @@unique([receiving_no])
  @@index([material_request_id])
  @@index([facility_id])
  @@index([status])
  @@index([created_by])
}

model material_request_receiving_item {
  id String @id @default(uuid()) @db.Uuid
  material_request_receiving_id String @db.Uuid
  material_request_item_id String @db.Uuid
  product_id String @db.Uuid
  unit_id String @db.Uuid
  qty Decimal @db.Decimal(14, 3)
  content_per_unit Decimal @default(1) @db.Decimal(14, 3)
  base_qty Decimal @db.Decimal(14, 3)
  receiving material_request_receiving @relation(fields: [material_request_receiving_id], references: [id], onDelete: Cascade, map: "mr_receiving_item_receiving_fkey")
  request_item material_request_item @relation(fields: [material_request_item_id], references: [id], onDelete: Restrict, map: "mr_receiving_item_request_item_fkey")
  product product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  unit measurement_unit @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  stock_movement stock_movement?

  @@unique([material_request_receiving_id, material_request_item_id], map: "mr_receiving_item_line_key")
  @@index([material_request_item_id])
  @@index([product_id])
  @@index([unit_id])
}

enum material_request_dispatch_status {
  posted
}

enum stock_movement_direction {
  in
  out
}

enum stock_movement_type {
  po_receive_in
  dispatch_out
  receive_in
}

model material_request_dispatch {
  id String @id @default(uuid()) @db.Uuid
  supplying_company_id String @db.Uuid
  material_request_id String @db.Uuid
  facility_id String @db.Uuid
  status material_request_dispatch_status @default(posted)
  dispatch_seq Int
  dispatch_no String @db.VarChar(64)
  notes String @default("") @db.VarChar(1000)
  created_by String @db.Uuid
  posted_by String @db.Uuid
  posted_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  company company @relation(fields: [supplying_company_id], references: [id], onDelete: Restrict)
  request material_request @relation(fields: [material_request_id], references: [id], onDelete: Restrict)
  facility facility @relation(fields: [facility_id], references: [id], onDelete: Restrict)
  items material_request_dispatch_item[]

  @@unique([supplying_company_id, dispatch_seq], map: "mr_dispatch_company_seq_key")
  @@unique([dispatch_no])
  @@index([material_request_id])
  @@index([facility_id])
  @@index([created_by])
}

model material_request_dispatch_item {
  id String @id @default(uuid()) @db.Uuid
  material_request_dispatch_id String @db.Uuid
  material_request_item_id String @db.Uuid
  product_id String @db.Uuid
  unit_id String @db.Uuid
  qty Decimal @db.Decimal(14, 3)
  content_per_unit Decimal @default(1) @db.Decimal(14, 3)
  base_qty Decimal @db.Decimal(14, 3)
  dispatch material_request_dispatch @relation(fields: [material_request_dispatch_id], references: [id], onDelete: Cascade, map: "mr_dispatch_item_dispatch_fkey")
  request_item material_request_item @relation(fields: [material_request_item_id], references: [id], onDelete: Restrict, map: "mr_dispatch_item_request_item_fkey")
  product product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  unit measurement_unit @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  stock_movement stock_movement?

  @@unique([material_request_dispatch_id, material_request_item_id], map: "mr_dispatch_item_line_key")
  @@index([material_request_item_id])
  @@index([product_id])
  @@index([unit_id])
}

model inventory {
  id String @id @default(uuid()) @db.Uuid
  facility_id String @db.Uuid
  product_id String @db.Uuid
  qty Decimal @default(0) @db.Decimal(14, 3)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  facility facility @relation(fields: [facility_id], references: [id], onDelete: Restrict)
  product product @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@unique([facility_id, product_id])
  @@index([product_id])
}

model stock_movement {
  id String @id @default(uuid()) @db.Uuid
  sequence BigInt @unique @default(autoincrement())
  facility_id String @db.Uuid
  product_id String @db.Uuid
  qty Decimal @db.Decimal(14, 3)
  balance_before Decimal? @db.Decimal(14, 3)
  balance_after Decimal? @db.Decimal(14, 3)
  direction stock_movement_direction
  type stock_movement_type
  po_receiving_item_id String? @unique @db.Uuid
  material_request_dispatch_item_id String? @unique @db.Uuid
  material_request_receiving_item_id String? @unique @db.Uuid
  created_by String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  facility facility @relation(fields: [facility_id], references: [id], onDelete: Restrict)
  product product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  po_receiving_item receiving_item? @relation(fields: [po_receiving_item_id], references: [id], onDelete: Restrict)
  dispatch_item material_request_dispatch_item? @relation(fields: [material_request_dispatch_item_id], references: [id], onDelete: Restrict, map: "stock_movement_dispatch_item_fkey")
  receiving_item material_request_receiving_item? @relation(fields: [material_request_receiving_item_id], references: [id], onDelete: Restrict, map: "stock_movement_receiving_item_fkey")

  @@index([facility_id, product_id, created_at])
  @@index([product_id])
  @@index([created_by])
}

model material_request_counter {
  company_id String @db.Uuid
  period String @db.VarChar(6)
  last_value Int
  company company @relation(fields: [company_id], references: [id], onDelete: Restrict)
  @@id([company_id, period])
}

enum purchase_order_status {
  draft
  awaiting_receipt
  partially_received
  received
  closed
}

enum purchase_order_event_kind {
  created
  confirmed
  receipt_posted
  closed
}

enum receiving_status {
  draft
  posted
}

model purchase_order {
  id                    String                 @id @default(uuid()) @db.Uuid
  company_id            String                 @db.Uuid
  facility_id           String                 @db.Uuid
  supplier_id           String                 @db.Uuid
  created_by            String?                @db.Uuid
  order_seq             Int
  purchase_order_no     String                 @db.VarChar(48)
  status                purchase_order_status  @default(draft)
  payment_terms         String                 @default("") @db.VarChar(160)
  payment_method        String?                @db.VarChar(32)
  estimated_delivery_at DateTime?              @db.Timestamptz(6)
  notes                 String                 @default("") @db.VarChar(1000)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @updatedAt @db.Timestamptz(6)
  company               company                @relation(fields: [company_id], references: [id], onDelete: Restrict)
  facility              facility               @relation(fields: [facility_id], references: [id], onDelete: Restrict)
  supplier              supplier               @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  items                 purchase_order_item[]
  receivings            receiving[]
  events                purchase_order_event[]

  @@unique([company_id, order_seq])
  @@unique([purchase_order_no])
  @@index([created_by])
  @@index([company_id])
  @@index([facility_id])
  @@index([supplier_id])
  @@index([status])
}

model purchase_order_item {
  id                String           @id @default(uuid()) @db.Uuid
  purchase_order_id String           @db.Uuid
  product_id        String           @db.Uuid
  unit_id           String           @db.Uuid
  ordered_qty       Decimal          @db.Decimal(14, 3)
  received_qty      Decimal          @default(0) @db.Decimal(14, 3)
  purchase_order    purchase_order   @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  product           product          @relation(fields: [product_id], references: [id], onDelete: Restrict)
  unit              measurement_unit @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  receiving_items   receiving_item[]

  @@unique([purchase_order_id, product_id])
  @@index([product_id])
  @@index([unit_id])
}

model purchase_order_event {
  id                String                     @id @default(uuid()) @db.Uuid
  purchase_order_id String                     @db.Uuid
  receiving_id      String?                    @db.Uuid
  kind              purchase_order_event_kind
  status            purchase_order_status
  note              String                     @default("") @db.VarChar(160)
  created_by        String?                    @db.Uuid
  created_at        DateTime                   @default(now()) @db.Timestamptz(6)
  purchase_order    purchase_order             @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  receiving         receiving?                 @relation(fields: [receiving_id], references: [id], onDelete: Restrict)

  @@index([purchase_order_id, created_at])
  @@index([receiving_id])
  @@index([created_by])
}

model receiving {
  id                String                   @id @default(uuid()) @db.Uuid
  company_id        String                   @db.Uuid
  purchase_order_id String                   @db.Uuid
  facility_id       String                   @db.Uuid
  status            receiving_status         @default(draft)
  receipt_seq       Int?
  receiving_no      String?                  @db.VarChar(32)
  notes             String                   @default("") @db.VarChar(1000)
  created_by        String?                  @db.Uuid
  posted_by         String?                  @db.Uuid
  posted_at         DateTime?                @db.Timestamptz(6)
  created_at        DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                 @updatedAt @db.Timestamptz(6)
  company           company                  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  purchase_order    purchase_order           @relation(fields: [purchase_order_id], references: [id], onDelete: Restrict)
  facility          facility                 @relation(fields: [facility_id], references: [id], onDelete: Restrict)
  items             receiving_item[]
  events            purchase_order_event[]

  @@unique([company_id, receipt_seq])
  @@unique([receiving_no])
  @@index([company_id])
  @@index([purchase_order_id])
  @@index([facility_id])
  @@index([status])
  @@index([created_by])
}

model receiving_item {
  id                     String           @id @default(uuid()) @db.Uuid
  receiving_id           String           @db.Uuid
  purchase_order_item_id String           @db.Uuid
  product_id             String           @db.Uuid
  unit_id                String           @db.Uuid
  qty                    Decimal          @db.Decimal(14, 3)
  content_per_unit       Decimal          @default(1) @db.Decimal(14, 3)
  base_qty               Decimal          @db.Decimal(14, 3)
  receiving              receiving        @relation(fields: [receiving_id], references: [id], onDelete: Cascade)
  purchase_order_item    purchase_order_item @relation(fields: [purchase_order_item_id], references: [id], onDelete: Restrict)
  product                product          @relation(fields: [product_id], references: [id], onDelete: Restrict)
  unit                   measurement_unit @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  stock_movement         stock_movement?

  @@unique([receiving_id, purchase_order_item_id])
  @@index([purchase_order_item_id])
  @@index([product_id])
  @@index([unit_id])
}
